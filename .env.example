# Public — safe to ship in the client bundle
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only, never prefixed with NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Owner contact, used to render WhatsApp/tel links and enquiry copy.
NEXT_PUBLIC_OWNER_PHONE=+2348116563757
NEXT_PUBLIC_OWNER_EMAIL=pzautomobiles@gmail.com

# Secret — server-only. Powers the admin form's spec/colour suggestion routes
# (app/api/admin/suggest-*). If unset, those routes return no suggestions and
# the form still works exactly as before.
ANTHROPIC_API_KEY=
